{
  "redirects": [
    {
      "source": "/test-rank",
      "destination": "https://badamtestranker.vercel.app/test-rank",
      "permanent": false
    },
    {
      "source": "/test-rank/:path*",
      "destination": "https://badamtestranker.vercel.app/test-rank/:path*",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "badamclasses.in"
        }
      ],
      "destination": "https://www.badamclasses.in/$1",
      "permanent": true
    }
  ]
}
